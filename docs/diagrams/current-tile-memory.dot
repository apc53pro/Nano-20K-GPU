digraph CurrentTileMemory {
  graph [rankdir=TB, bgcolor="white", compound=true, newrank=true,
         fontname="DejaVu Sans", fontsize=22, fontcolor="#172b3a",
         labelloc=t, label="Current GPU model — overlapped tile export and geometry lookahead\nN20K-SYS-0.1 — exact native ports, ordered commands and shared SDRAM",
         pad=0.30, nodesep=0.30, ranksep=0.55, splines=polyline];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#245b8c",
        fontname="DejaVu Sans", fontsize=11, fontcolor="#172b3a", penwidth=1.4, margin="0.14,0.10"];
  edge [color="#1d7f79", fontcolor="#172b3a", fontname="DejaVu Sans", fontsize=9, penwidth=1.3, arrowsize=0.7, constraint=false];

  submit [label="Ordered SUBMIT_PASS\nDescriptor address from packet RAM\nFront / sealed targets cannot be written\nInvalidate texture tags for newly uploaded contents"];
  subgraph cluster_fetch {
    label="Command fetch — SDRAM records, one shared Reader and bounded fields";
    color="#a8c2db"; style=rounded; fontsize=13;
    descriptor [label="Fetch 32-byte pass descriptor\nTarget, independent CLEAR/LOAD flags\nClear RGB565 / D24 and tile-table address\nRequire initialized attachments for LOAD"];
    entry [label="For tile 0…299: fetch 8-byte table entry\n{list address, reference count}\n20 columns ×15 rows of logical 32×32 tiles\nEmpty bins still resolve both attachments"];
    reader [label="Reader: 2 ×SDPB1024×16, x32 port\n512-byte payload + alignment guard\nPipeline synchronous controller-slot reads\nSame established word enters RAM + fields\n≤320-byte decoded-field register bank\nREAD_MEMORY later streams native RAM reads", color="#6957a3", fillcolor="#f3effb"];
    descriptor -> entry [label="captured fields"];
    descriptor -> reader [label="32 / 8 byte reads", dir=both, constraint=false];
    {rank=same; descriptor; entry; reader;}
  }
  submit -> descriptor [label="start pass", color="#245b8c", style=dashed];

  subgraph cluster_init {
    label="Initialize one resident rendering tile";
    color="#a8c2db"; style=rounded; fontsize=13;
    loadop [label="Resolve independent load operations\nCLEAR: write constants into resident ports\nLOAD: per row fetch color 64 B / depth 128 B\nUnpack through synchronous staging writes\nPrime + 32 resident writes per loaded row"];
    banksets [label="Two physical bank sets; 3 native banks each\nEach set: RGB56516 / depth-low16 / high8\nEach bank: SDPB1024×16, 1024 addresses\nOne read + one write per bank / edge\nSame-address simultaneous R/W forbidden\nRole selector routes ports; no pixel-array copy", color="#6957a3", fillcolor="#f3effb"];
    loadop -> banksets [label="resident-role native writes"];
    entry -> loadop [label="next tile", color="#245b8c", style=dashed];
    loadop -> reader [label="Tile-client LOAD reads", dir=both, constraint=false];
    {rank=same; loadop; banksets;}
  }

  subgraph cluster_draw {
    label="Primitive loop — current draw and one-record lookahead run concurrently";
    color="#d6b58f"; style=rounded; fontsize=13;
    reference [label="Fetch next 4-byte primitive address\nThen its 320-byte record\nReference order preserved\nOne reference lookahead, no record cache\nRecord refetched for each tile reference"];
    draw [label="Capture next primitive only after prior drain\nCoverage / interpolation / D24\nShared-reciprocal U/V / streaming cache / RGB\n64 bounded fragment contexts\nCurrent primitive owns captured tile registers", color="#b76118", fillcolor="#fff2e6"];
    lookahead [label="While current primitive draws:\nReader + field bank fetch following record\n32-bit address + 2-bit state +invalid flag\nNo second record RAM or decoded-field bank\nDecode/fault transition after current draw drains"];
    texture [label="Texture cache / copy scratch: 1 native bank\n2 KiB, 64 lines ×16 RGB565 words\nOne outstanding miss; younger lookups held\nRefill one halfword / edge\nNext slot read overlaps current low-half write", color="#6957a3", fillcolor="#f3effb"];
    loadop -> reference [label="tile initialized", color="#245b8c", style=dashed];
    reference -> draw [label="first or ready prefetched fields"];
    draw -> lookahead [label="next reference exists", color="#245b8c", style=dashed];
    lookahead -> reference [label="fetch concurrently", color="#245b8c", style=dashed, constraint=false];
    reference -> reader [label="Command reads", dir=both, constraint=false];
    draw -> banksets [label="depth reads / conditional commits", dir=both, constraint=false];
    draw -> texture [label="registered lookup / texel", dir=both];
    {rank=same; reference; draw; lookahead;}
  }

  subgraph cluster_export {
    label="Completed-tile export — all color and depth values persist by pass completion";
    color="#a8c2db"; style=rounded; fontsize=13;
    mode [label="Both attachments CLEAR?", shape=diamond];
    exchange [label="Wait for previous export to release its banks\nExchange resident/export roles on one edge\n1024 pixels published by port routing\nNo 1024-pixel memory copy"];
    background [label="Background export of completed bank set\nNext tile initializes and draws in other set\nThree existing staging banks now use 1024 words\nNo additional BSRAM or DSP"];
    serial [label="Either attachment LOAD:\nKeep load / draw / store serialized\nStaging used for 32-pixel LOAD rows\nStore reads resident bank ports directly"];
    words [label="Word-wide tile source through native ports\nColor: two 16-bit pixel reads per 32-bit word\nDepth: parallel low/high read → D24/U32 word\n32-bit output hold + 16-bit color-half register\nOne staged 32-bit client word / eligible edge\nNo byte-serialization array"];
    rows [label="For each of 32 rows:\nColor 64 B, depth-low-half 64 B, high-half 64 B\n16-word client fill →publish →write ACK\nOne owned Tile slot; backpressure retained"];
    next [label="More tiles?", shape=diamond];
    done [label="Final export acknowledged\nMark target color + shared depth valid\nRetire SUBMIT_PASS; FENCE may complete\nPRESENT separately waits for vertical blank"];
    draw -> mode [label="all references drained", color="#245b8c", style=dashed];
    loadop -> mode [label="empty bin", color="#245b8c", style=dashed, constraint=false];
    mode -> exchange [label="yes", color="#245b8c", style=dashed];
    mode -> serial [label="no", color="#245b8c", style=dashed];
    exchange -> background [label="export-role ports"];
    exchange -> next [label="resident role free immediately", color="#245b8c", style=dashed];
    background -> words [label="staged native reads"];
    serial -> words [label="resident native reads"];
    words -> rows [label="32-bit words"];
    rows -> next [label="LOAD: after tile ACK", color="#245b8c", style=dashed, constraint=false];
    rows -> done [label="last tile ACK", color="#245b8c", style=dashed];
    next -> entry [label="yes", color="#245b8c", style=dashed, constraint=false];
    next -> done [label="no: wait for final ACK", color="#245b8c", style=dashed];
    banksets -> words [label="selected export / resident B ports", constraint=false];
    {rank=same; mode; exchange; serial;}
    {rank=same; background; words; rows;}
    {rank=same; next; done;}
  }

  subgraph cluster_memory {
    label="Shared memory controller — six owned native slots, one physical SDR bus";
    color="#b8add7"; style=rounded; fontsize=13;
    clients [label="Host / Command / Tile / Texture / Copy / Scanout\nOne owned ≤16-word x32 slot per client\nTwo native x16 banks each: 12 total\nWrite requests / read responses share storage\nOne synchronous word port per direction\nHeld response blocks slot reuse"];
    arb [label="One active transaction\nScanout quota ≤4 grants while others wait\nOther clients round-robin\nRefresh guard reserves worst-case service\nDefault deadline ≤1575 core edges"];
    sdr [label="Common core/SDR clock: 100.8 MHz assumption\nCL3, tRP/RCD/WR/MRD 3, tRFC 9\ntRAS 6, tRC 9, turnarounds 2\nSequential aligned BL8 x32 physical bursts\nShort/unaligned requests still pay BL8\nDQM masks padding writes"];
    memory [label="Embedded SDR SDRAM: 8 MiB, x32\n4 banks ×2048 rows ×256 columns\nColor 0: 0x000000, color 1: 0x096000\nD24/U32: 0x12C000\nHeap: 0x258000…0x7FFFFF\n403.2 MB/s raw peak at assumed 100.8 MHz", shape=cylinder, color="#6957a3", fillcolor="#f3effb"];
    reader -> clients [label="Command / Tile reads", dir=both, constraint=false];
    rows -> clients [label="Tile writes / ACK", dir=both];
    texture -> clients [label="Texture refill", dir=both, constraint=false];
    clients -> arb -> sdr;
    sdr -> memory [label="native commands / DQ", dir=both];
    {rank=same; clients; arb; sdr; memory;}
  }

  subgraph cluster_parallel {
    label="Other operations and independently advancing display";
    color="#9ac8c1"; style=rounded; fontsize=13;
    uploads [label="Ordered WRITE_HEAP commands\nClocked 8-bit packet source / 32-bit pack\nExecute after earlier pass releases resources\nCPU keeps unchanged textures resident\nNo asynchronous upload-write bypass"];
    copy [label="COPY_RECT outside passes\nReuse cache bank as ≤640-pixel row scratch\nRead entire row before writing it\nChoose safe forward/reverse row order\nDepth unchanged; texture tags invalidated"];
    scan [label="Independent FRONT-only scanout\nScanout slot synchronous 32-bit reads\nOne 32-bit hold → two RGB565 FIFO writes\n2048-pixel FIFO: 2 native banks\n25.2 MHz pixels / 800×525 totals / 60 Hz\nUnderflow blanks until next vertical blank\nPRESENT swaps only at vertical blank"];
    uploads -> clients [label="Host client", dir=both, constraint=false];
    copy -> clients [label="Copy client", dir=both, constraint=false];
    copy -> texture [label="exclusive scratch owner", color="#6957a3", style=dotted, dir=both, constraint=false];
    scan -> clients [label="Scanout client", dir=both, constraint=false];
    done -> scan [label="later PRESENT", color="#245b8c", style=dashed, constraint=false];
    {rank=same; uploads; copy; scan;}
  }

  accounting [label="Traffic / accounting\nEach pass stores 1,843,200 useful color+depth bytes; LOAD of both adds 1,843,200 read bytes\nBoot explicitly writes 2,457,600 attachment bytes; exclude boot when measuring steady-state submissions\n39 native BSRAM = 14 renderer + 25 system; 46/48 native 18×18 DSP equivalents\nOne resident +one completed tile use two existing three-bank sets selected by a role mux\nEight 64-bit optimization counters; bounded lookahead/export controls; no hidden record payload storage\nFit and achieved clock unproven; model FPS is not measured FPGA performance\nHost observers, CPU texture snapshots and diagnostics add no GPU memory ports\nSolid teal: data. Dashed blue: control. Dotted purple: shared resource. HDMI signaling excluded.",
              shape=note, color="#879dad", fillcolor="#f7f9fb", fontsize=11];
  // Invisible grid constrains layout only; visible arrows describe execution.
  edge [style=invis, constraint=true, weight=1000];
  submit -> descriptor -> loadop -> reference -> texture -> mode
         -> background -> next -> clients -> uploads -> accounting;
  descriptor -> entry -> reader;
  loadop -> banksets;
  reference -> draw -> lookahead;
  mode -> exchange -> serial;
  background -> words -> rows;
  next -> done;
  clients -> arb -> sdr -> memory;
  uploads -> copy -> scan;

}
