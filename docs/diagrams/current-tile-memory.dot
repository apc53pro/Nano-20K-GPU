digraph CurrentTileMemory {
  graph [rankdir=TB, bgcolor="white", compound=true, newrank=true,
         fontname="DejaVu Sans", fontsize=22, fontcolor="#172b3a",
         labelloc=t, label="Current GPU model 44f0c8f\nN20K-SYS-0.1 — exact tile lifecycle, SDRAM traffic, copy reuse and scanout",
         pad=0.30, nodesep=0.28, ranksep=0.60, splines=polyline];
  node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#245b8c",
        fontname="DejaVu Sans", fontsize=11, fontcolor="#172b3a", penwidth=1.4, margin="0.14,0.10"];
  edge [color="#1d7f79", fontcolor="#172b3a", fontname="DejaVu Sans", fontsize=9, penwidth=1.3, arrowsize=0.7, constraint=false];

  submit [label="Ordered SUBMIT_PASS\nu32 descriptor address from packet RAM\nFront / sealed targets cannot be written"];
  subgraph cluster_fetch {
    label="Command fetch — prepared records are stored in SDRAM, not injected from host objects";
    color="#a8c2db"; style=rounded; fontsize=13;
    descriptor [label="Fetch 32-byte pass descriptor\nTarget, independent CLEAR/LOAD flags\nRGB565/D24 clear values, tile-table address\nRequire initialized attachments for LOAD"];
    entry [label="For tile 0…299: fetch 8-byte table entry\n{list address, reference count}\n20 columns ×15 rows of logical 32×32 tiles\nEmpty bins still load and store attachments"];
    submit -> descriptor [label="start pass", color="#245b8c", style=dashed];
    descriptor -> entry [label="descriptor captured on later edge", color="#245b8c", style=dashed];
    {rank=same; descriptor; entry;}
  }

  subgraph cluster_load {
    label="Load one resident tile — repeat the row sequence 32 times; color then depth are scheduled in order";
    color="#a8c2db"; style=rounded; fontsize=13;
    row_start [label="Start tile row y=0…31\nGlobal pixel address from tile origin\nNo overlap with a previous tile's stores"];
    color_load [label="Resolve color load operation\nCLEAR: replicate RGB565 constant\nLOAD: fetch 32 pixels =64 bytes\nthrough the Tile SDRAM client"];
    depth_load [label="Resolve depth load operation\nCLEAR: replicate D24 constant\nLOAD: fetch 32 U32 values =128 bytes\nTwo serial 64-byte reads"];
    rows [label="Bounded row staging\n32 ×16-bit color =64 bytes\n32 ×32-bit depth =128 bytes\nNo complete tile kept in staging arrays", color="#6957a3", fillcolor="#f3effb"];
    local_load [label="LoadLocal: 32 enabled edges per row\nWrite same 10-bit address to 3 banks\nColor16 + depth-low16 + depth-high8\nParallel full-word native writes"];
    load_next [label="All 32 rows loaded?", shape=diamond, fillcolor="#edf4fb"];
    ready [label="Tile ready\nExactly one resident tile\nConsume its ordered reference list"];
    entry -> row_start [label="begin tile", color="#245b8c", style=dashed];
    row_start -> color_load [color="#245b8c", style=dashed];
    color_load -> depth_load [label="after color resolved", color="#245b8c", style=dashed];
    depth_load -> rows [label="after depth resolved"];
    rows -> local_load [label="one pixel's attachments / edge"];
    local_load -> load_next [color="#245b8c", style=dashed];
    load_next -> row_start [label="no: next row", color="#245b8c", style=dashed, constraint=false];
    load_next -> ready [label="yes", color="#245b8c", style=dashed];
    {rank=same; row_start; color_load; depth_load; rows;}
    {rank=same; local_load; load_next; ready;}
  }

  subgraph cluster_draw {
    label="Primitive loop — one draw drains before the next record; detailed fragment datapath is a separate view";
    color="#d6b58f"; style=rounded; fontsize=13;
    has_refs [label="Any references?", shape=diamond, fillcolor="#edf4fb"];
    reference [label="Fetch next 4-byte primitive address\nPreserve reference-list order\nGlobal pass-reference limit: 1,048,576"];
    record [label="Fetch 320-byte primitive record\nTriangle / rectangle / line / sprite\nTexture descriptor only, no host pixels\nRecord refetched for each tile reference"];
    draw [label="begin_external() → clocked draw\nCoverage / interpolation / D24\nSerial U/V correction / texture cache / shade\nOne retained textured fragment\nWait until tile.busy() becomes false", color="#b76118", fillcolor="#fff2e6"];
    refs_left [label="More references\nin this tile?", shape=diamond, fillcolor="#edf4fb"];
    tile_banks [label="Resident tile memory: 3 native banks\nColor: SDPB 1024×16 (RGB565)\nDepth low: SDPB 1024×16 (bits 0…15)\nDepth high: SDPB 1024×16 (bits 16…23)\nUnused depth-high bits stay zero", color="#6957a3", fillcolor="#f3effb"];
    texture [label="Texture cache / copy scratch: 1 bank\nSDPB 1024×16, 2 KiB\n64 direct-mapped lines ×16 RGB565 words\nOne outstanding miss / refill\nCache misses use shared SDRAM", color="#6957a3", fillcolor="#f3effb"];
    ready -> has_refs [color="#245b8c", style=dashed];
    has_refs -> reference [label="yes", color="#245b8c", style=dashed];
    reference -> record [label="bounded aligned heap address"];
    record -> draw [label="prepared record captured"];
    draw -> refs_left [label="drained", color="#245b8c", style=dashed];
    refs_left -> reference [label="yes: fetch next", color="#245b8c", style=dashed, constraint=false];
    draw -> tile_banks [label="registered depth read / conditional commit", dir=both];
    draw -> texture [label="lookup / registered texel", dir=both];
    local_load -> tile_banks [label="1024 local writes per tile", constraint=false];
    {rank=same; has_refs; reference; record;}
    {rank=same; draw; refs_left;}
    {rank=same; tile_banks; texture;}
  }

  subgraph cluster_store {
    label="Store one tile — every row and both attachments; no dirty-row suppression";
    color="#a8c2db"; style=rounded; fontsize=13;
    store_local [label="StoreLocal: read 32 tile positions\n32 parallel 3-bank read requests\n+1 registered-output drain edge\nThen separate StorePrepare edge"];
    store_color [label="Store RGB565 row: 64 bytes\nWriter fills ≤1 byte / core edge\nSubmit ≤16 ×32-bit words\nWait for SDRAM acknowledgement"];
    store_depth_lo [label="Store first 16 D24/U32 values: 64 bytes\nFill / submit / wait for acknowledgement"];
    store_depth_hi [label="Store next 16 D24/U32 values: 64 bytes\nFill / submit / wait for acknowledgement"];
    store_next [label="All 32 rows stored?", shape=diamond, fillcolor="#edf4fb"];
    tile_next [label="All 300 tiles stored?", shape=diamond, fillcolor="#edf4fb"];
    pass_done [label="Pass retires after final write ACK\nMark target color + shared depth valid\nFENCE can report ordered completion\nSeparate PRESENT waits for vblank"];
    has_refs -> store_local [label="no: empty bin", color="#245b8c", style=dashed, constraint=false];
    refs_left -> store_local [label="no: all draws drained", color="#245b8c", style=dashed];
    tile_banks -> store_local [label="old registered results", constraint=false];
    store_local -> store_color [label="row data captured"];
    store_color -> store_depth_lo [label="ACK", color="#245b8c", style=dashed];
    store_depth_lo -> store_depth_hi [label="ACK", color="#245b8c", style=dashed];
    store_depth_hi -> store_next [label="ACK", color="#245b8c", style=dashed];
    store_next -> store_local [label="no: next row", color="#245b8c", style=dashed, constraint=false];
    store_next -> tile_next [label="yes", color="#245b8c", style=dashed];
    tile_next -> entry [label="no: next tile", color="#245b8c", style=dashed, constraint=false];
    tile_next -> pass_done [label="yes", color="#245b8c", style=dashed];
    {rank=same; store_local; store_color; store_depth_lo; store_depth_hi;}
    {rank=same; store_next; tile_next; pass_done;}
  }

  subgraph cluster_io {
    label="Shared bounded memory adapters and physical controller — backpressure affects every dependent state";
    color="#b8add7"; style=rounded; fontsize=13;
    reader [label="Shared Reader FSM\n512-byte record / readback registers\n16 ×32-bit response staging\nDrain ≤1 word / core edge\nConsumer captures on a later edge"];
    writer [label="Shared Writer FSM\n16 ×32-bit data +16 byte masks\nFill from one-byte source port\nRequest → wait for completion"];
    clients [label="Six SDRAM clients\nCommand: descriptors / bins / records / readback\nTile: attachment boot / load / store\nTexture: cache miss; Copy: direct color copy\nHost: uploads; Scanout: front-buffer reads\nOne owned ≤16-word slot per client"];
    arbitration [label="Arbiter / refresh reservation\n≤4 consecutive Scanout selections\nwhen other clients wait; others round-robin\nOne request owns the bus until complete\nRefresh deadline ≤1575 core cycles\nReserve worst-case transaction + precharge"];
    controller [label="100.8 MHz common-clock SDR controller\nCL3; tRP/RCD/WR/MRD=3, tRFC=9\ntRAS=6, tRC=9, turnarounds=2\nSelected timing assumptions, not measured limits\nAligned sequential BL8 x32 transactions\nDQM masks padding writes", color="#6957a3", fillcolor="#f3effb"];
    memory [label="8 MiB embedded SDRAM\n4 banks ×2048 rows ×256 columns ×32 bits\nWord mapping: row11 | bank2 | col8\nColor 0: 0x000000, 614400 bytes\nColor 1: 0x096000, 614400 bytes\nD24/U32: 0x12C000, 1228800 bytes\nHeap: 0x258000…0x7FFFFF, 5931008 bytes", shape=cylinder, color="#6957a3", fillcolor="#f3effb"];
    record -> reader [label="Command fetches:\n32 / 8 / 4 / 320 bytes", dir=both, constraint=false];
    depth_load -> reader [label="Tile LOAD reads:\ncolor 64 B + depth 2×64 B", dir=both, constraint=false];
    reader -> clients [label="Command or Tile request / response", dir=both];
    store_color -> writer [label="64-byte source / completion", dir=both, constraint=false];
    writer -> clients [label="Tile write / response", dir=both];
    texture -> clients [label="Texture request / response", dir=both, constraint=false];
    clients -> arbitration [label="bounded ownership / backpressure", dir=both];
    arbitration -> controller [label="grant / registered completion", dir=both];
    controller -> memory [label="native commands and DQ beats", dir=both];
    {rank=same; reader; writer; clients;}
    {rank=same; arbitration; controller; memory;}
  }

  subgraph cluster_copy {
    label="COPY_RECT alternative — ordered outside render passes, same cache bank, depth unchanged";
    color="#9ac8c1"; style=rounded; fontsize=13;
    copy_begin [label="Validate ownership and clip rectangle\nImage or physical-framebuffer source\nChoose forward / reverse row order\n10 shift/add edges for row addresses"];
    copy_fill [label="Read complete clipped source row\nCopy SDRAM client, bounded responses\nWrite ≤640 RGB565 words into scratch\nAll source pixels buffered before writes"];
    copy_emit [label="Read scratch through native RAM port\nCapture old result; pack ≤32 pixels\nMasked ≤16-word destination request\nWait for each Copy acknowledgement\nNext group, then next row"];
    copy_begin -> copy_fill [label="invalidate texture tags", color="#245b8c", style=dashed];
    copy_fill -> copy_emit [label="full row buffered"];
    copy_fill -> texture [label="exclusive scratch owner", dir=both, color="#6957a3", style=dotted, constraint=false];
    copy_fill -> clients [label="Copy source reads", dir=both, constraint=false];
    copy_emit -> clients [label="Copy destination writes / ACK", dir=both, constraint=false];
    copy_emit -> copy_fill [label="next row in selected direction", color="#245b8c", style=dashed, constraint=false];
    {rank=same; copy_begin; copy_fill; copy_emit;}
  }

  subgraph cluster_display {
    label="Scanout remains concurrent with the ordered pass / copy engine";
    color="#9ac8c1"; style=rounded; fontsize=13;
    display_read [label="Continuous current-front reads\nScanout client, one tagged request\n16 ×32-bit response staging"];
    display_fifo [label="Display FIFO: 2048 RGB565 pixels\n2 × SDPB 1024×16\nRead request → registered capture\nNever reads the back target", color="#6957a3", fillcolor="#f3effb"];
    display_pixel [label="25.2 MHz pixel enable, 60 Hz\nH=640 +16 front +96 sync +48 back\nV=480 +10 front +2 sync +33 back\nUnderflow blanks rest of frame\nResynchronize / swap at vertical blank\nSDL is a host observation; no HDMI model"];
    display_read -> clients [label="Scanout request / response", dir=both, constraint=false];
    display_read -> display_fifo [label="one RGB565 word / core edge"];
    display_fifo -> display_pixel [label="registered FIFO output"];
    pass_done -> display_read [label="PRESENT may change front at vblank", color="#245b8c", style=dashed, constraint=false];
    {rank=same; display_read; display_fifo; display_pixel;}
  }

  accounting [label="Current traffic / storage limits\nEvery pass stores all 300 tiles: 1843200 useful color+depth bytes\nLOAD of both attachments adds another 1843200 bytes; CLEAR avoids those reads\nBoot explicitly writes both color buffers + shared depth: 2457600 bytes\n12 native BSRAM =3 tile +1 cache/copy +2 scanout +5 host +1 reply\nAdditional >2 KiB bounded staging, LUT/FF use and physical timing remain unproven\nOne active ordered executor operation; only scanout and host parsing progress independently\nCPU prepared-record consistency checks are simulation assertions, not timed GPU validation units\nSolid teal: data / request-response. Dashed blue: control. Dotted purple: reused memory.",
              shape=note, color="#879dad", fillcolor="#f7f9fb", fontsize=11];
  // Invisible grid is layout only; every visible arrow is a real data/control relationship.
  edge [style=invis, constraint=true, weight=1000];
  submit -> descriptor -> row_start -> local_load -> has_refs -> draw -> tile_banks
         -> store_local -> store_next -> reader -> arbitration -> copy_begin
         -> display_read -> accounting;
  descriptor -> entry;
  row_start -> color_load -> depth_load -> rows;
  local_load -> load_next -> ready;
  has_refs -> reference -> record;
  draw -> refs_left;
  tile_banks -> texture;
  store_local -> store_color -> store_depth_lo -> store_depth_hi;
  store_next -> tile_next -> pass_done;
  reader -> writer -> clients;
  arbitration -> controller -> memory;
  copy_begin -> copy_fill -> copy_emit;
  display_read -> display_fifo -> display_pixel;
  descriptor [group=phase_left]; row_start [group=phase_left];
  local_load [group=phase_left]; has_refs [group=phase_left];
  draw [group=phase_left]; tile_banks [group=phase_left];
  store_local [group=phase_left]; store_next [group=phase_left];
  reader [group=phase_left]; arbitration [group=phase_left];
  copy_begin [group=phase_left]; display_read [group=phase_left];
}
