digraph CurrentRenderer {
  graph [label="Current GPU renderer — shared reciprocal and streaming fragments\nN20K-HW-RENDER-0.3 · bounded contexts, backpressure and ordered retirement",
    labelloc=t, labeljust=l, fontname="DejaVu Sans", fontsize=22,
    bgcolor="white", charset="UTF-8", rankdir=TB, compound=true,
    newrank=true, nodesep=0.28, ranksep=0.55, pad=0.3, splines=polyline];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12,
    margin="0.14,0.10", color="#245b8c", fontcolor="#183448", fillcolor="#edf4fa", penwidth=1.4];
  edge [fontname="DejaVu Sans", fontsize=10, color="#1d7f79", fontcolor="#1d7f79", arrowsize=0.75, penwidth=1.3, constraint=false];

  subgraph cluster_walk {
    label="1 · Primitive capture, setup and sample generation";
    fontname="DejaVu Sans"; fontsize=15; color="#b9cbdc"; style=rounded;
    prepared [label="Immutable prepared primitive\n1 capture edge; bind texture\nCPU clipping / triangle setup external\nDrain before next primitive"];
    setup [label="Triangle initialization\n6 products ×4 edges =24\nONE dedicated setup MULT18X18\nExact Δy + Δx plane-anchor walk"];
    walk [label="Triangle / 2D walker\nQ4 centers and top-left coverage\nSigned32 edges; signed64 planes\nRect / sprite grid; global line walk\nAt most one candidate / edge\nOutside coverage: advance without token"];
    {rank=same; prepared; setup; walk;}
    prepared -> setup -> walk;
  }

  subgraph cluster_accept {
    label="2 · Separate untextured and textured paths";
    fontname="DejaVu Sans"; fontsize=15; color="#9ac8c1"; style=rounded;
    need [shape=diamond, label="Covered candidate:\ntexture needed?"];
    fast [label="Untextured fast path\nONE pending fragment\nDepth read → next-edge compare / commit\nCan retire N while accepting N+1\nSame-address depth forwarding", color="#1d7f79", fillcolor="#e7f4f2"];
    allocate [label="Textured context allocation\n64-entry ordered ring / six-bit tag\nCommit address + D24; RGB factor\nStop walker when credits unavailable", color="#b76118", fillcolor="#fff2e5"];
    depth [label="Early D24\nNative read at acceptance\nCompare on following edge\nReject before UV / sampling"];
    depth_note [shape=note, label="Why no depth retest at retirement?\nEach supported primitive visits a pixel once.\nPrimitives drain before another begins.\nFuture primitive overlap needs a hazard policy.", fontsize=11];
    {rank=same; need; fast; allocate; depth;}
    need -> fast [label="no"];
    need -> allocate [label="yes"];
    allocate -> depth;
    depth -> depth_note [style=dotted, arrowhead=none];
  }
  walk -> need [label="covered candidate"];

  subgraph cluster_uv {
    label="3 · Shared-reciprocal U/V pipeline — initiation interval ONE";
    fontname="DejaVu Sans"; fontsize=15; color="#d9ad83"; style=rounded;
    normalize [label="Normalize q and signed U/V\nCarry six-bit context tag\nq raw domain [2^29, 2^37]\nSprites bypass this entire stage", color="#b76118", fillcolor="#fff2e5"];
    seed [label="Synchronous linear seed ROM\n256 entries\n35-bit base: THREE native banks\n16-bit gradient: ONE native bank", color="#6957a3", fillcolor="#f1edf8"];
    refine [label="Refine one reciprocal for U and V\nRegistered native18×18 partial products\n40 DSP equivalents across full UV unit\nNo assumed free wide multiply", color="#b76118", fillcolor="#fff2e5"];
    exact [label="Bounded exact quotient correction\nSignedQ16 round-to-nearest-even\nBoth U/V and error flags + context tag\n26 enabled unit edges TOTAL\nParent captures on following edge", color="#b76118", fillcolor="#fff2e5"];
    {rank=same; normalize; seed; refine; exact;}
    normalize -> seed -> refine -> exact;
  }
  depth -> normalize [label="pass / disabled, textured triangle"];

  subgraph cluster_texture {
    label="4 · Streaming texture hit path — initiation interval ONE, at most eight reservations";
    fontname="DejaVu Sans"; fontsize=15; color="#b7acd2"; style=rounded;
    address_mode [label="Address coordinates\nTriangle: signedQ16 floor / clamp / repeat\nSprite: existing integer source X/Y\nPreserve clipped source origin"];
    factor [label="Synchronous RGB-factor handoff\nTWO SDPB banks, 64 ×RGB888\nRead context tag → later capture\nTwo elastic coordinate/factor stages", color="#6957a3", fillcolor="#f1edf8"];
    address [label="Pitched word address\ny × (pitch_low17 + pitch_high ×2^17) + x\nTWO native registered18×18 DSPs\nSeparate address / tag registers"];
    read [label="Tag and synchronous cache read\nONE SDPB1024×16 bank\n64 direct-mapped lines ×16 texels\nNative B read → later output capture\n7 enabled unit edges on hit TOTAL\nParent captures on following edge", color="#6957a3", fillcolor="#f1edf8"];
    miss [label="Miss service / replay\nFreeze younger address and DSP stages\nOlder cache results drain in order\nSystem: one owned Texture SDRAM slot\nSync32-bit reads → one held word\nTwo16-bit native writes per word\nPad final short-line tail without extra reads", color="#6957a3", fillcolor="#f1edf8"];
    {rank=same; address_mode; factor; address; read;}
    address_mode -> factor -> address -> read;
    read -> miss [label="miss"];
    miss -> read [label="line valid; replay held request", constraint=false];
  }
  exact -> address_mode;
  depth -> address_mode [label="pass / disabled, sprite", constraint=false];

  subgraph cluster_shading {
    label="5 · Raw key test and parallel RGB shading — initiation interval ONE";
    fontname="DejaVu Sans"; fontsize=15; color="#d9ad83"; style=rounded;
    key [shape=diamond, label="Raw RGB565\nkey match?"];
    rgb [label="Replace or RGB modulation\nTHREE parallel registered18×18 DSPs\n3 unit edges + parent capture\nExact rounded /255 shift-add\nSprites / replacement use factor255\nthrough the same RGB stages", color="#b76118", fillcolor="#fff2e5"];
    result [label="Store RGB565 result\nONE native context-result bank\nResult +ready update on one edge\nScheduler sees OLD ready flags\nIndependent color/depth write controls", color="#6957a3", fillcolor="#f1edf8"];
    factor_fifo [label="Matching texture-context FIFO\n8 bounded register entries\nSix-bit tag +24-bit RGB factor\nRetain until ordered texture output"];
    {rank=same; key; factor_fifo; rgb; result;}
    key -> rgb [label="keep"];
    factor_fifo -> rgb [label="matching RGB factor"];
    rgb -> result;
  }
  read -> key [label="old registered texel"];
  miss -> key [style=invis];
  factor -> factor_fifo [label="captured with texture request", style=dashed, constraint=false];
  read -> factor_fifo [label="pop matching context", style=dashed, constraint=false];

  subgraph cluster_retire {
    label="6 · Ordered completion and attachment commit";
    fontname="DejaVu Sans"; fontsize=15; color="#9ac8c1"; style=rounded;
    ready [label="Bounded ready/reason registers\n64 ready bits +64 ×2-bit reasons\nCommit / depth reject / key reject\nA younger ready entry waits for older work"];
    context_read [label="Retirement context ports\nTHREE commit-metadata SDPB banks\nTile address10 +D24, 64 entries\nONE RGB565 result bank, shared with shade\nSynchronous read → separate capture", color="#6957a3", fillcolor="#f1edf8"];
    retire [label="Retire oldest fragment once\nConditional RGB565 and D24 writes\nRejects write neither attachment\nRelease context credit\nOne retirement may overlap acceptance", color="#1d7f79", fillcolor="#e7f4f2"];
    tile [shape=cylinder, label="Resident32×32 tile\nTHREE SDPB1024×16 banks\nRGB565 / depth low16 / depth high8\nUnused high-depth bits remain zero", color="#6957a3", fillcolor="#f1edf8"];
    {rank=same; ready; context_read; retire; tile;}
    ready -> context_read -> retire -> tile;
  }
  result -> ready [label="next-edge retirement scheduler"];
  key -> ready [label="key rejection", constraint=false];
  depth -> ready [label="depth rejection", constraint=false];
  fast -> tile [label="enabled writes", constraint=false];
  tile -> depth [label="early native read", style=dashed, constraint=false];
  retire -> allocate [label="release oldest context", style=dashed, constraint=false];

  resources [shape=note, fontsize=12, label="SELECTED RESOURCES / CLOCK QUALIFICATION\nRenderer:14 BSRAM =3 tile +1 cache/copy +6 context +4 seed ROM\nSystem:39 of46 BSRAM =renderer14 +2 scanout +5 host +1 reply +12 client slots +2 reader +3 row\n46 of48 native18×18 equivalents =1 setup +40 UV +2 texture address +3 RGB\nThe selected schedule permits overlap; misses/backpressure/context exhaustion cause bubbles.\nCore/SDRAM100.8MHz is a configurable assumption. Whole-GPU fit and achieved timing are not established.\nOld serial divider /14-edge texture-hit APIs remain standalone oracles, outside selected GPU execution.", color="#879dad", fillcolor="#f7f9fc"];
  trace [shape=note, fontsize=11, label="HOST-ONLY OBSERVATION\nPer-edge accepted and retired tokens; batch cancellation during reset/recovery\nWalker phase is not exclusive utilization of concurrent arithmetic/cache/shading blocks\nHardware activity counters overlap: do not sum them into elapsed clocks\nSystem last_pass_cycles includes record fetch, tile DMA, drawing and memory waits\nTrace IDs, scoreboards and CSV/JSON create no FPGA state or GPU memory ports", color="#879dad", fillcolor="#f7f9fc"];
  ready -> resources [style=invis, weight=1000];
  resources -> trace [style=invis];
  allocate -> trace [style=dotted, constraint=false, color="#879dad"];
  retire -> trace [style=dotted, constraint=false, color="#879dad"];
  prepared [group="spine"]; need [group="spine"]; normalize [group="spine"];
  address_mode [group="spine"]; key [group="spine"]; ready [group="spine"];
  resources [group="spine"]; trace [group="spine"];
  prepared -> need [style=invis, weight=1000];
  depth_note -> normalize [style=invis, weight=1000];
  normalize -> address_mode [style=invis, weight=1000];
  miss -> key [style=invis, weight=1000];
  key -> factor_fifo [style=invis, weight=1000];
  key -> ready [style=invis, weight=1000];
  // Invisible grid is layout only; visible arrows retain data/control meaning.
  edge [style=invis, constraint=true, weight=1000];
  prepared -> need -> depth_note -> normalize -> address_mode -> miss -> key -> ready -> resources -> trace;
  prepared -> setup -> walk;
  need -> fast -> allocate -> depth;
  normalize -> seed -> refine -> exact;
  address_mode -> factor -> address -> read;
  key -> factor_fifo -> rgb -> result;
  ready -> context_read -> retire -> tile;
  depth_note [group="spine"]; miss [group="spine"];
}
